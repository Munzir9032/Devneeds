---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/global.css";
---

<BaseLayout
    title="JSON Viewer & Tree Visualizer - DevNeeds"
    description="Free online interactive JSON viewer. Explore nested JSON trees, expand and collapse nodes, and inspect keys and types."
>
    <Header />

    <main class="tool-page">
        <div class="container">
            <div class="tool-header">
                <a href="/tools" class="back-link">← All tools</a>
                <div class="badge">JSON</div>
                <h1>JSON Viewer & Tree</h1>
                <p>Explore nested JSON objects through an interactive collapsible tree structure.</p>
            </div>

            <div class="options-bar">
                <div class="action-buttons">
                    <button id="expand-all-btn" type="button" class="btn-action">Expand All</button>
                    <button id="collapse-all-btn" type="button" class="btn-action">Collapse All</button>
                    <button id="sample-btn" type="button" class="btn-action">Sample</button>
                    <button id="clear-btn" type="button" class="btn-ghost">Clear</button>
                </div>
            </div>

            <div class="editor-grid">
                <div class="panel">
                    <div class="panel-header">
                        <label for="raw-input">Raw JSON Input</label>
                    </div>
                    <textarea
                        id="raw-input"
                        placeholder="Paste your JSON here..."
                        spellcheck="false"
                    ></textarea>
                </div>

                <div class="panel">
                    <div class="panel-header">
                        <label>Interactive Tree View</label>
                    </div>
                    <div id="tree-container" class="tree-container">
                        <span class="tree-placeholder">Tree hierarchy will render here...</span>
                    </div>
                </div>
            </div>

            <div id="error-box" class="error-box" hidden></div>
            <p class="privacy-tag">⚡ Tree generation runs entirely inside your browser memory.</p>
        </div>
    </main>

    <Footer />
</BaseLayout>

<script>
    const rawInput = document.querySelector("#raw-input") as HTMLTextAreaElement | null;
    const treeContainer = document.querySelector("#tree-container") as HTMLDivElement | null;
    const errorBox = document.querySelector("#error-box") as HTMLDivElement | null;
    const clearBtn = document.querySelector("#clear-btn") as HTMLButtonElement | null;
    const sampleBtn = document.querySelector("#sample-btn") as HTMLButtonElement | null;
    const expandAllBtn = document.querySelector("#expand-all-btn") as HTMLButtonElement | null;
    const collapseAllBtn = document.querySelector("#collapse-all-btn") as HTMLButtonElement | null;

    const SAMPLE = {
        name: "DevNeeds",
        version: 2.5,
        production: true,
        maintainers: [{ id: 1, handle: "admin" }],
        services: { storage: "browser-native", auth: null }
    };

    function createNode(key: string | null, value: unknown): HTMLElement {
        const line = document.createElement("div");
        line.className = "tree-line";

        const isObject = typeof value === "object" && value !== null;
        const isArray = Array.isArray(value);

        if (isObject) {
            const details = document.createElement("details");
            details.open = true;

            const summary = document.createElement("summary");
            summary.className = "tree-summary";

            const keySpan = document.createElement("span");
            keySpan.className = "node-key";
            keySpan.textContent = key !== null ? `"${key}": ` : "";

            const badge = document.createElement("span");
            badge.className = "node-badge";
            const keys = Object.keys(value as Record<string, unknown>);
            badge.textContent = isArray ? `Array(${keys.length})` : `{${keys.length}}`;

            summary.appendChild(keySpan);
            summary.appendChild(badge);
            details.appendChild(summary);

            const childrenWrap = document.createElement("div");
            childrenWrap.className = "tree-children";

            for (const subKey of keys) {
                const subVal = (value as Record<string, unknown>)[subKey];
                childrenWrap.appendChild(createNode(subKey, subVal));
            }

            details.appendChild(childrenWrap);
            line.appendChild(details);
        } else {
            const leaf = document.createElement("div");
            leaf.className = "tree-leaf";

            if (key !== null) {
                const keySpan = document.createElement("span");
                keySpan.className = "node-key";
                keySpan.textContent = `"${key}": `;
                leaf.appendChild(keySpan);
            }

            const valSpan = document.createElement("span");
            if (typeof value === "string") {
                valSpan.className = "type-string";
                valSpan.textContent = `"${value}"`;
            } else if (typeof value === "number") {
                valSpan.className = "type-number";
                valSpan.textContent = String(value);
            } else if (typeof value === "boolean") {
                valSpan.className = "type-boolean";
                valSpan.textContent = String(value);
            } else if (value === null) {
                valSpan.className = "type-null";
                valSpan.textContent = "null";
            }
            leaf.appendChild(valSpan);
            line.appendChild(leaf);
        }

        return line;
    }

    function renderTree() {
        if (!rawInput || !treeContainer || !errorBox) return;
        const raw = rawInput.value.trim();

        if (!raw) {
            treeContainer.innerHTML = '<span class="tree-placeholder">Tree hierarchy will render here...</span>';
            errorBox.hidden = true;
            return;
        }

        try {
            const parsed = JSON.parse(raw);
            treeContainer.innerHTML = "";
            treeContainer.appendChild(createNode(null, parsed));
            errorBox.hidden = true;
        } catch (err: unknown) {
            treeContainer.innerHTML = '<span class="tree-placeholder">Failed to render tree</span>';
            errorBox.hidden = false;
            errorBox.textContent = err instanceof Error ? err.message : "Invalid JSON";
        }
    }

    rawInput?.addEventListener("input", renderTree);

    sampleBtn?.addEventListener("click", () => {
        if (rawInput) {
            rawInput.value = JSON.stringify(SAMPLE, null, 2);
            renderTree();
        }
    });

    clearBtn?.addEventListener("click", () => {
        if (rawInput) rawInput.value = "";
        renderTree();
        rawInput?.focus();
    });

    expandAllBtn?.addEventListener("click", () => {
        document.querySelectorAll("#tree-container details").forEach((el) => {
            (el as HTMLDetailsElement).open = true;
        });
    });

    collapseAllBtn?.addEventListener("click", () => {
        document.querySelectorAll("#tree-container details").forEach((el) => {
            (el as HTMLDetailsElement).open = false;
        });
    });
</script>

<style>
    .tool-page { padding: 50px 0 90px; }
    .container { max-width: 1280px; margin: 0 auto; padding: 0 24px; width: 100%; }
    .tool-header { margin-bottom: 24px; }
    .back-link { display: block; margin-bottom: 12px; color: #6366f1; font-size: 13px; font-weight: 600; text-decoration: none; }
    .badge { display: inline-block; margin-bottom: 10px; font-size: 11px; font-weight: 800; letter-spacing: 1.2px; color: #6366f1; }
    .tool-header h1 { margin: 0 0 10px; font-size: clamp(32px, 4vw, 44px); letter-spacing: -1.5px; color: #111827; }
    .tool-header p { margin: 0; color: #64748b; font-size: 16px; }

    .options-bar { margin-bottom: 18px; }
    .action-buttons { display: flex; gap: 8px; flex-wrap: wrap; }

    .editor-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 20px; }
    .panel {
        display: flex;
        flex-direction: column;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
    }
    .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 18px;
        border-bottom: 1px solid #f1f5f9;
        background: #fafafa;
    }
    .panel-header label { font-size: 13px; font-weight: 700; color: #374151; text-transform: uppercase; letter-spacing: 0.5px; }

    .btn-ghost { background: transparent; border: none; color: #94a3b8; font-size: 12px; font-weight: 600; cursor: pointer; padding: 4px 8px; border-radius: 4px; }
    .btn-ghost:hover { color: #ef4444; }
    .btn-action { background: #eef2ff; border: 1px solid #c7d2fe; color: #4f46e5; font-size: 12px; font-weight: 700; padding: 4px 12px; border-radius: 6px; cursor: pointer; }
    .btn-action:hover { background: #e0e7ff; }

    textarea {
        width: 100%;
        min-height: 480px;
        padding: 18px;
        border: none;
        outline: none;
        resize: vertical;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 14px;
        line-height: 1.6;
        color: #1f2937;
        background: #ffffff;
        box-sizing: border-box;
    }

    .tree-container {
        padding: 18px;
        min-height: 480px;
        max-height: 600px;
        overflow-y: auto;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 13px;
        line-height: 1.7;
    }
    .tree-placeholder { color: #94a3b8; }

    :global(.tree-line) { margin: 2px 0; }
    :global(.tree-summary) { cursor: pointer; outline: none; user-select: none; }
    :global(.tree-children) { padding-left: 18px; border-left: 1px dashed #e2e8f0; margin-left: 6px; }
    :global(.node-key) { color: #0284c7; font-weight: 600; }
    :global(.node-badge) { font-size: 11px; background: #f1f5f9; color: #64748b; padding: 1px 6px; border-radius: 4px; margin-left: 4px; }
    :global(.type-string) { color: #16a34a; }
    :global(.type-number) { color: #d97706; }
    :global(.type-boolean) { color: #7c3aed; }
    :global(.type-null) { color: #94a3b8; font-style: italic; }

    .error-box {
        margin-top: 16px;
        padding: 12px 16px;
        border-radius: 8px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #dc2626;
        font-size: 14px;
    }
    .privacy-tag { margin-top: 24px; color: #9ca3af; font-size: 13px; text-align: center; }

    @media (max-width: 820px) {
        .editor-grid { grid-template-columns: 1fr; }
        textarea, .tree-container { min-height: 250px; }
    }
</style>