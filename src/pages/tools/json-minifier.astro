---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/global.css";
---

<BaseLayout
    title="JSON Minifier - DevNeeds"
    description="Free online JSON minifier. Strip spaces, newlines, and shrink JSON payloads instantly to reduce transmission size."
>
    <Header />

    <main class="tool-page">
        <div class="container">
            <div class="tool-header">
                <a href="/tools" class="back-link">← All tools</a>
                <div class="badge">JSON</div>
                <h1>JSON Minifier</h1>
                <p>Strip unnecessary whitespace and indentation to produce ultra-compact JSON strings.</p>
            </div>

            <div class="options-bar">
                <div class="stats" id="compression-stats">Ready to minify</div>
                <div class="action-buttons">
                    <button id="sample-btn" type="button" class="btn-action">Sample</button>
                    <button id="clear-btn" type="button" class="btn-ghost">Clear</button>
                </div>
            </div>

            <div class="editor-grid">
                <div class="panel">
                    <div class="panel-header">
                        <label for="json-input">Formatted JSON Input</label>
                    </div>
                    <textarea
                        id="json-input"
                        placeholder="Paste formatted JSON here..."
                        spellcheck="false"
                    ></textarea>
                </div>

                <div class="panel">
                    <div class="panel-header">
                        <label for="json-output">Minified Output</label>
                        <button id="copy-btn" type="button" class="btn-action">
                            <span id="copy-label">Copy</span>
                        </button>
                    </div>
                    <textarea
                        id="json-output"
                        readonly
                        placeholder="Minified single-line JSON will appear here..."
                        spellcheck="false"
                    ></textarea>
                </div>
            </div>

            <div id="error-box" class="error-box" hidden></div>
            <p class="privacy-tag">⚡ Minification runs instantly on the client side without network calls.</p>
        </div>
    </main>

    <Footer />
</BaseLayout>

<script>
    const jsonInput = document.querySelector("#json-input") as HTMLTextAreaElement | null;
    const jsonOutput = document.querySelector("#json-output") as HTMLTextAreaElement | null;
    const clearBtn = document.querySelector("#clear-btn") as HTMLButtonElement | null;
    const sampleBtn = document.querySelector("#sample-btn") as HTMLButtonElement | null;
    const copyBtn = document.querySelector("#copy-btn") as HTMLButtonElement | null;
    const copyLabel = document.querySelector("#copy-label") as HTMLSpanElement | null;
    const errorBox = document.querySelector("#error-box") as HTMLDivElement | null;
    const compressionStats = document.querySelector("#compression-stats") as HTMLDivElement | null;

    function minify() {
        if (!jsonInput || !jsonOutput || !errorBox || !compressionStats) return;
        const raw = jsonInput.value.trim();

        if (!raw) {
            jsonOutput.value = "";
            errorBox.hidden = true;
            compressionStats.textContent = "Ready to minify";
            return;
        }

        try {
            const parsed = JSON.parse(raw);
            const minified = JSON.stringify(parsed);
            jsonOutput.value = minified;

            const originalBytes = new TextEncoder().encode(raw).length;
            const minifiedBytes = new TextEncoder().encode(minified).length;
            const saved = Math.max(0, originalBytes - minifiedBytes);
            const percent = originalBytes > 0 ? ((saved / originalBytes) * 100).toFixed(1) : "0";

            compressionStats.textContent = `Saved ${saved} bytes (${percent}% reduction)`;
            errorBox.hidden = true;
        } catch (err: unknown) {
            jsonOutput.value = "";
            compressionStats.textContent = "Error parsing JSON";
            errorBox.hidden = false;
            errorBox.textContent = err instanceof Error ? err.message : "Invalid JSON input";
        }
    }

    jsonInput?.addEventListener("input", minify);

    sampleBtn?.addEventListener("click", () => {
        if (jsonInput) {
            jsonInput.value = JSON.stringify({
                app: "DevNeeds",
                mode: "client",
                dependencies: []
            }, null, 4);
            minify();
        }
    });

    clearBtn?.addEventListener("click", () => {
        if (jsonInput) jsonInput.value = "";
        minify();
        jsonInput?.focus();
    });

    copyBtn?.addEventListener("click", async () => {
        if (!jsonOutput?.value) return;
        await navigator.clipboard.writeText(jsonOutput.value);
        if (copyLabel) {
            const original = copyLabel.textContent;
            copyLabel.textContent = "Copied!";
            setTimeout(() => {
                copyLabel.textContent = original;
            }, 1600);
        }
    });
</script>

<style>
    .tool-page { padding: 50px 0 90px; }
    .container { max-width: 1280px; margin: 0 auto; padding: 0 24px; width: 100%; }
    .tool-header { margin-bottom: 24px; }
    .back-link { display: block; margin-bottom: 12px; color: #6366f1; font-size: 13px; font-weight: 600; text-decoration: none; }
    .badge { display: inline-block; margin-bottom: 10px; font-size: 11px; font-weight: 800; letter-spacing: 1.2px; color: #6366f1; }
    .tool-header h1 { margin: 0 0 10px; font-size: clamp(32px, 4vw, 44px); letter-spacing: -1.5px; color: #111827; }
    .tool-header p { margin: 0; color: #64748b; font-size: 16px; }

    .options-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }
    .stats { font-size: 13px; font-weight: 600; color: #6366f1; }
    .action-buttons { display: flex; gap: 8px; }

    .editor-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .panel {
        display: flex;
        flex-direction: column;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
    }
    .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 18px;
        border-bottom: 1px solid #f1f5f9;
        background: #fafafa;
    }
    .panel-header label { font-size: 13px; font-weight: 700; color: #374151; text-transform: uppercase; letter-spacing: 0.5px; }

    .btn-ghost { background: transparent; border: none; color: #94a3b8; font-size: 12px; font-weight: 600; cursor: pointer; padding: 4px 8px; border-radius: 4px; }
    .btn-ghost:hover { color: #ef4444; }
    .btn-action { background: #eef2ff; border: 1px solid #c7d2fe; color: #4f46e5; font-size: 12px; font-weight: 700; padding: 4px 12px; border-radius: 6px; cursor: pointer; }
    .btn-action:hover { background: #e0e7ff; }

    textarea {
        width: 100%;
        min-height: 420px;
        padding: 18px;
        border: none;
        outline: none;
        resize: vertical;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 14px;
        line-height: 1.6;
        color: #1f2937;
        background: #ffffff;
        box-sizing: border-box;
    }

    .error-box {
        margin-top: 16px;
        padding: 12px 16px;
        border-radius: 8px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #dc2626;
        font-size: 14px;
    }
    .privacy-tag { margin-top: 24px; color: #9ca3af; font-size: 13px; text-align: center; }

    @media (max-width: 820px) {
        .editor-grid { grid-template-columns: 1fr; }
        textarea { min-height: 240px; }
    }
</style>