---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/global.css";
---

<BaseLayout
    title="JSON Diff Checker - DevNeeds"
    description="Free online JSON diff tool. Compare two JSON payloads with side-by-side line numbers and in-place added/removed line highlighting."
>
    <Header />

    <main class="tool-page">
        <div class="container">
            <div class="tool-header">
                <a href="/tools" class="back-link">← All tools</a>
                <div class="badge">JSON</div>
                <h1>JSON Diff</h1>
                <p>Compare two JSON objects side-by-side with line numbers and in-place highlighted changes.</p>
            </div>

            <div class="options-bar">
                <div class="action-buttons">
                    <button id="compare-btn" type="button" class="btn-primary">Compare JSON</button>
                    <button id="sample-btn" type="button" class="btn-action">Load Sample</button>
                    <button id="clear-btn" type="button" class="btn-ghost">Clear</button>
                </div>
                <div id="diff-stats" class="diff-stats"></div>
            </div>

            <!-- Error Banner -->
            <div id="error-box" class="error-box" hidden></div>

            <!-- Side-by-Side Editors with Line Numbers and Highlights -->
            <div class="inputs-grid">
                <!-- Panel A -->
                <div class="panel">
                    <div class="panel-header">
                        <label for="left-json">Original JSON (A)</label>
                        <span id="left-status" class="editor-status"></span>
                    </div>
                    <div class="editor-wrap">
                        <div id="left-gutter" class="gutter" aria-hidden="true"></div>
                        <div class="textarea-container">
                            <div id="left-highlights" class="highlights-layer" aria-hidden="true"></div>
                            <textarea id="left-json" placeholder="Paste original JSON..." spellcheck="false" wrap="off"></textarea>
                        </div>
                    </div>
                </div>

                <!-- Panel B -->
                <div class="panel">
                    <div class="panel-header">
                        <label for="right-json">Modified JSON (B)</label>
                        <span id="right-status" class="editor-status"></span>
                    </div>
                    <div class="editor-wrap">
                        <div id="right-gutter" class="gutter" aria-hidden="true"></div>
                        <div class="textarea-container">
                            <div id="right-highlights" class="highlights-layer" aria-hidden="true"></div>
                            <textarea id="right-json" placeholder="Paste modified JSON..." spellcheck="false" wrap="off"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Differences Summary View -->
            <div class="panel diff-panel">
                <div class="panel-header">
                    <label>Unified Diff View</label>
                    <div class="legend">
                        <span class="legend-item"><span class="legend-dot added"></span> Added in B</span>
                        <span class="legend-item"><span class="legend-dot removed"></span> Removed from A</span>
                    </div>
                </div>
                <div id="diff-output" class="diff-output">
                    <span class="diff-placeholder">Paste JSON into both panels or click 'Load Sample' to compare...</span>
                </div>
            </div>

            <p class="privacy-tag">⚡ Comparisons execute locally within your browser. No data leaves your machine.</p>
        </div>
    </main>

    <Footer />
</BaseLayout>

<script>
    const leftInput = document.querySelector("#left-json") as HTMLTextAreaElement | null;
    const rightInput = document.querySelector("#right-json") as HTMLTextAreaElement | null;
    const leftGutter = document.querySelector("#left-gutter") as HTMLDivElement | null;
    const rightGutter = document.querySelector("#right-gutter") as HTMLDivElement | null;
    const leftHighlights = document.querySelector("#left-highlights") as HTMLDivElement | null;
    const rightHighlights = document.querySelector("#right-highlights") as HTMLDivElement | null;
    const leftStatus = document.querySelector("#left-status") as HTMLElement | null;
    const rightStatus = document.querySelector("#right-status") as HTMLElement | null;
    const diffOutput = document.querySelector("#diff-output") as HTMLDivElement | null;
    const diffStats = document.querySelector("#diff-stats") as HTMLDivElement | null;
    const errorBox = document.querySelector("#error-box") as HTMLDivElement | null;
    const compareBtn = document.querySelector("#compare-btn") as HTMLButtonElement | null;
    const sampleBtn = document.querySelector("#sample-btn") as HTMLButtonElement | null;
    const clearBtn = document.querySelector("#clear-btn") as HTMLButtonElement | null;

    // Synchronize scrolling between textarea, gutter, and highlights layer
    function syncScroll(textarea: HTMLTextAreaElement, gutter: HTMLDivElement | null, highlights: HTMLDivElement | null) {
        if (gutter) gutter.scrollTop = textarea.scrollTop;
        if (highlights) {
            highlights.scrollTop = textarea.scrollTop;
            highlights.scrollLeft = textarea.scrollLeft;
        }
    }

    leftInput?.addEventListener("scroll", () => syncScroll(leftInput, leftGutter, leftHighlights));
    rightInput?.addEventListener("scroll", () => syncScroll(rightInput, rightGutter, rightHighlights));

    // LCS line-based diff algorithm
    function computeLineDiff(linesA: string[], linesB: string[]) {
        const n = linesA.length;
        const m = linesB.length;
        const matrix: number[][] = Array.from({ length: n + 1 }, () => Array(m + 1).fill(0));

        for (let i = 1; i <= n; i++) {
            for (let j = 1; j <= m; j++) {
                if (linesA[i - 1] === linesB[j - 1]) {
                    matrix[i][j] = matrix[i - 1][j - 1] + 1;
                } else {
                    matrix[i][j] = Math.max(matrix[i - 1][j], matrix[i][j - 1]);
                }
            }
        }

        let i = n;
        let j = m;
        const result: Array<{ type: "added" | "removed" | "same"; text: string; lineA?: number; lineB?: number }> = [];

        while (i > 0 || j > 0) {
            if (i > 0 && j > 0 && linesA[i - 1] === linesB[j - 1]) {
                result.unshift({ type: "same", text: linesA[i - 1], lineA: i, lineB: j });
                i--;
                j--;
            } else if (j > 0 && (i === 0 || matrix[i][j - 1] >= matrix[i - 1][j])) {
                result.unshift({ type: "added", text: linesB[j - 1], lineB: j });
                j--;
            } else if (i > 0 && (j === 0 || matrix[i][j - 1] < matrix[i - 1][j])) {
                result.unshift({ type: "removed", text: linesA[i - 1], lineA: i });
                i--;
            }
        }

        return result;
    }

    function renderGutterAndHighlights(
        textarea: HTMLTextAreaElement,
        gutter: HTMLDivElement | null,
        highlights: HTMLDivElement | null,
        changedLines: Set<number>,
        type: "removed" | "added"
    ) {
        if (!gutter || !highlights) return;

        const lines = textarea.value.split("\n");
        const total = Math.max(1, lines.length);

        let gutterHtml = "";
        let highlightsHtml = "";

        for (let i = 1; i <= total; i++) {
            const isChanged = changedLines.has(i);
            const className = isChanged ? (type === "removed" ? "line-removed" : "line-added") : "";
            gutterHtml += `<div class="gutter-cell ${className}">${i}</div>`;
            highlightsHtml += `<div class="highlight-cell ${className}"></div>`;
        }

        gutter.innerHTML = gutterHtml;
        highlights.innerHTML = highlightsHtml;
    }

    function runDiff() {
        if (!leftInput || !rightInput || !diffOutput || !errorBox || !diffStats) return;

        const leftRaw = leftInput.value.trim();
        const rightRaw = rightInput.value.trim();

        if (leftStatus) leftStatus.textContent = "";
        if (rightStatus) rightStatus.textContent = "";

        if (!leftRaw || !rightRaw) {
            diffOutput.innerHTML = '<span class="diff-placeholder">Paste JSON into both panels or click \'Load Sample\' to compare...</span>';
            diffStats.textContent = "";
            errorBox.hidden = true;
            renderGutterAndHighlights(leftInput, leftGutter, leftHighlights, new Set(), "removed");
            renderGutterAndHighlights(rightInput, rightGutter, rightHighlights, new Set(), "added");
            return;
        }

        let parsedA: any, parsedB: any;
        let hasError = false;

        try {
            parsedA = JSON.parse(leftRaw);
        } catch (err: unknown) {
            hasError = true;
            if (leftStatus) {
                leftStatus.textContent = "Invalid JSON";
                leftStatus.className = "editor-status error";
            }
            errorBox.hidden = false;
            errorBox.textContent = `Original JSON (A) Error: ${err instanceof Error ? err.message : "Syntax failure"}`;
        }

        try {
            parsedB = JSON.parse(rightRaw);
        } catch (err: unknown) {
            hasError = true;
            if (rightStatus) {
                rightStatus.textContent = "Invalid JSON";
                rightStatus.className = "editor-status error";
            }
            errorBox.hidden = false;
            errorBox.textContent = `Modified JSON (B) Error: ${err instanceof Error ? err.message : "Syntax failure"}`;
        }

        if (hasError) {
            diffOutput.innerHTML = '<span class="diff-placeholder">Fix syntax errors above to view differences.</span>';
            diffStats.textContent = "";
            renderGutterAndHighlights(leftInput, leftGutter, leftHighlights, new Set(), "removed");
            renderGutterAndHighlights(rightInput, rightGutter, rightHighlights, new Set(), "added");
            return;
        }

        errorBox.hidden = true;

        // Compare lines directly from the pasted raw inputs
        const linesA = leftInput.value.split("\n");
        const linesB = rightInput.value.split("\n");
        const diffs = computeLineDiff(linesA, linesB);

        const removedLineNumbersA = new Set<number>();
        const addedLineNumbersB = new Set<number>();

        diffs.forEach((d) => {
            if (d.type === "removed" && d.lineA !== undefined) removedLineNumbersA.add(d.lineA);
            if (d.type === "added" && d.lineB !== undefined) addedLineNumbersB.add(d.lineB);
        });

        // Apply in-place highlights & line numbers to both input boxes
        renderGutterAndHighlights(leftInput, leftGutter, leftHighlights, removedLineNumbersA, "removed");
        renderGutterAndHighlights(rightInput, rightGutter, rightHighlights, addedLineNumbersB, "added");

        // Render the Unified bottom view
        diffOutput.innerHTML = "";
        const additions = addedLineNumbersB.size;
        const deletions = removedLineNumbersA.size;

        if (additions === 0 && deletions === 0) {
            diffOutput.innerHTML = '<div class="diff-line identical">✓ Identical: Both JSON payloads are exact matches.</div>';
            diffStats.textContent = "0 differences";
            return;
        }

        diffs.forEach((d) => {
            const row = document.createElement("div");
            row.className = `diff-line ${d.type}`;
            const prefix = d.type === "added" ? "+ " : d.type === "removed" ? "- " : "  ";
            row.textContent = `${prefix}${d.text}`;
            diffOutput.appendChild(row);
        });

        diffStats.textContent = `${additions + deletions} line changes (+${additions} added, -${deletions} removed)`;
    }

    compareBtn?.addEventListener("click", runDiff);
    leftInput?.addEventListener("input", runDiff);
    rightInput?.addEventListener("input", runDiff);

    sampleBtn?.addEventListener("click", () => {
        if (leftInput && rightInput) {
            leftInput.value = JSON.stringify({
                user: {
                    id: 1001,
                    profile: {
                        name: "John Doe",
                        email: "john@example.com",
                        roles: ["admin", "developer"]
                    }
                },
                active: true
            }, null, 2);

            rightInput.value = JSON.stringify({
                user: {
                    id: 1001,
                    profile: {
                        name: "John Doe",
                        email: "john@exple.com",
                        roles: ["admin", "developer"]
                    }
                },
                active: true
            }, null, 2);

            runDiff();
        }
    });

    clearBtn?.addEventListener("click", () => {
        if (leftInput) leftInput.value = "";
        if (rightInput) rightInput.value = "";
        if (leftStatus) leftStatus.textContent = "";
        if (rightStatus) rightStatus.textContent = "";
        if (diffStats) diffStats.textContent = "";
        if (diffOutput) diffOutput.innerHTML = '<span class="diff-placeholder">Paste JSON into both panels or click \'Load Sample\' to compare...</span>';
        if (errorBox) errorBox.hidden = true;
        if (leftGutter) leftGutter.innerHTML = "";
        if (rightGutter) rightGutter.innerHTML = "";
        if (leftHighlights) leftHighlights.innerHTML = "";
        if (rightHighlights) rightHighlights.innerHTML = "";
        leftInput?.focus();
    });

    // Initialize line numbers on empty initial load
    renderGutterAndHighlights(leftInput!, leftGutter, leftHighlights, new Set(), "removed");
    renderGutterAndHighlights(rightInput!, rightGutter, rightHighlights, new Set(), "added");
</script>

<style>
    .tool-page { padding: 50px 0 90px; }
    .container { max-width: 1280px; margin: 0 auto; padding: 0 24px; width: 100%; }
    .tool-header { margin-bottom: 24px; }
    .back-link { display: block; margin-bottom: 12px; color: #6366f1; font-size: 13px; font-weight: 600; text-decoration: none; }
    .badge { display: inline-block; margin-bottom: 10px; font-size: 11px; font-weight: 800; letter-spacing: 1.2px; color: #6366f1; }
    .tool-header h1 { margin: 0 0 10px; font-size: clamp(32px, 4vw, 44px); letter-spacing: -1.5px; color: #111827; }
    .tool-header p { margin: 0; color: #64748b; font-size: 16px; }

    .options-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
        flex-wrap: wrap;
        gap: 12px;
    }
    .action-buttons { display: flex; gap: 8px; }
    .diff-stats { font-size: 13px; font-weight: 700; color: #4f46e5; }

    .inputs-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
    
    .panel {
        display: flex;
        flex-direction: column;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
    }
    .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 18px;
        border-bottom: 1px solid #f1f5f9;
        background: #fafafa;
    }
    .panel-header label { font-size: 13px; font-weight: 700; color: #374151; text-transform: uppercase; letter-spacing: 0.5px; }

    .editor-status.error {
        font-size: 11px;
        font-weight: 700;
        color: #dc2626;
        background: #fee2e2;
        padding: 2px 8px;
        border-radius: 4px;
    }

    /* Editor Wrapper Layout */
    .editor-wrap {
        display: flex;
        position: relative;
        background: #ffffff;
        min-height: 300px;
    }

    .gutter {
        width: 48px;
        padding: 16px 0;
        background: #f8fafc;
        border-right: 1px solid #e5e7eb;
        color: #94a3b8;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 13px;
        line-height: 1.6;
        text-align: right;
        user-select: none;
        overflow: hidden;
        flex-shrink: 0;
    }

    :global(.gutter-cell) {
        padding-right: 10px;
        height: 20.8px; /* font-size (13px) * line-height (1.6) */
        box-sizing: border-box;
    }

    :global(.gutter-cell.line-removed) {
        background: #fee2e2;
        color: #dc2626;
        font-weight: 800;
        border-left: 3px solid #dc2626;
        padding-right: 7px;
    }

    :global(.gutter-cell.line-added) {
        background: #dcfce7;
        color: #15803d;
        font-weight: 800;
        border-left: 3px solid #16a34a;
        padding-right: 7px;
    }

    /* Highlights layer aligned behind transparent textarea */
    .textarea-container {
        position: relative;
        flex: 1;
        overflow: hidden;
    }

    .highlights-layer {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        padding: 16px 0;
        pointer-events: none;
        overflow: hidden;
    }

    :global(.highlight-cell) {
        height: 20.8px;
        box-sizing: border-box;
    }

    :global(.highlight-cell.line-removed) {
        background: #fee2e2;
    }

    :global(.highlight-cell.line-added) {
        background: #dcfce7;
    }

    textarea {
        position: relative;
        width: 100%;
        height: 100%;
        min-height: 300px;
        padding: 16px 14px;
        border: none;
        outline: none;
        resize: vertical;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 13px;
        line-height: 1.6;
        color: #1f2937;
        background: transparent;
        box-sizing: border-box;
        white-space: pre;
        overflow: auto;
    }

    .legend { display: flex; gap: 14px; align-items: center; }
    .legend-item { display: flex; align-items: center; gap: 5px; font-size: 12px; color: #64748b; font-weight: 600; }
    .legend-dot { width: 8px; height: 8px; border-radius: 50%; }
    .legend-dot.added { background: #16a34a; }
    .legend-dot.removed { background: #dc2626; }

    .btn-primary { background: #4f46e5; border: none; color: #ffffff; font-size: 12px; font-weight: 700; padding: 7px 16px; border-radius: 6px; cursor: pointer; }
    .btn-primary:hover { background: #4338ca; }
    .btn-ghost { background: transparent; border: none; color: #94a3b8; font-size: 12px; font-weight: 600; cursor: pointer; padding: 4px 8px; border-radius: 4px; }
    .btn-ghost:hover { color: #ef4444; }
    .btn-action { background: #eef2ff; border: 1px solid #c7d2fe; color: #4f46e5; font-size: 12px; font-weight: 700; padding: 4px 12px; border-radius: 6px; cursor: pointer; }
    .btn-action:hover { background: #e0e7ff; }

    .error-box {
        margin-bottom: 20px;
        padding: 12px 16px;
        border-radius: 8px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #dc2626;
        font-size: 14px;
        font-weight: 600;
    }

    .diff-panel { min-height: 280px; }
    .diff-output {
        padding: 12px 0;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 13px;
        line-height: 1.6;
        background: #ffffff;
        max-height: 480px;
        overflow-y: auto;
    }
    .diff-placeholder { padding: 0 18px; color: #94a3b8; }

    :global(.diff-line) {
        padding: 2px 18px;
        white-space: pre;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }
    :global(.diff-line.same) { color: #64748b; }
    :global(.diff-line.added) { background: #ecfdf5; color: #065f46; font-weight: 600; }
    :global(.diff-line.removed) { background: #fef2f2; color: #991b1b; font-weight: 600; }
    :global(.diff-line.identical) { background: #f0fdf4; color: #15803d; border-bottom: 1px solid #bbf7d0; padding: 12px 18px; }

    .privacy-tag { margin-top: 24px; color: #9ca3af; font-size: 13px; text-align: center; }

    @media (max-width: 820px) {
        .inputs-grid { grid-template-columns: 1fr; }
    }
</style>