---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/global.css";
---

<BaseLayout
    title="JSON Validator - DevNeeds"
    description="Free online JSON validator. Detect JSON syntax errors, parse payloads, and inspect line numbers with error highlighting."
>
    <Header />

    <main class="tool-page">
        <div class="container">
            <div class="tool-header">
                <a href="/tools" class="back-link">← All tools</a>
                <div class="badge">JSON</div>
                <h1>JSON Validator</h1>
                <p>Validate JSON structure with line numbers and instant error line highlighting.</p>
            </div>

            <div class="validator-layout">
                <!-- Editor Container with Line Numbers -->
                <div class="panel">
                    <div class="panel-header">
                        <label for="json-input">JSON Payload</label>
                        <div class="panel-actions">
                            <button id="sample-btn" type="button" class="btn-action">Load Sample</button>
                            <button id="clear-btn" type="button" class="btn-ghost">Clear</button>
                        </div>
                    </div>
                    
                    <div class="editor-wrapper">
                        <!-- Line Number Gutter -->
                        <div id="line-gutter" class="line-gutter" aria-hidden="true">1</div>
                        
                        <!-- Text Input Area -->
                        <textarea
                            id="json-input"
                            placeholder="Paste JSON here to validate..."
                            spellcheck="false"
                            wrap="off"
                        ></textarea>
                    </div>
                </div>

                <!-- Metrics & Error Status -->
                <div class="meta-panel">
                    <div id="validation-banner" class="banner empty">
                        Enter JSON to see validation results
                    </div>

                    <div class="metrics-card">
                        <h3>Payload Metrics</h3>
                        <div class="metrics-grid">
                            <div class="metric">
                                <span class="metric-label">Status</span>
                                <span id="metric-status" class="metric-value">-</span>
                            </div>
                            <div class="metric">
                                <span class="metric-label">Error Line</span>
                                <span id="metric-errline" class="metric-value">-</span>
                            </div>
                            <div class="metric">
                                <span class="metric-label">Size</span>
                                <span id="metric-size" class="metric-value">0 B</span>
                            </div>
                            <div class="metric">
                                <span class="metric-label">Lines</span>
                                <span id="metric-lines" class="metric-value">0</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <p class="privacy-tag">⚡ Validation runs strictly in your browser. No data leaves your machine.</p>
        </div>
    </main>

    <Footer />
</BaseLayout>

<script>
    const jsonInput = document.querySelector("#json-input") as HTMLTextAreaElement | null;
    const lineGutter = document.querySelector("#line-gutter") as HTMLDivElement | null;
    const banner = document.querySelector("#validation-banner") as HTMLDivElement | null;
    const clearBtn = document.querySelector("#clear-btn") as HTMLButtonElement | null;
    const sampleBtn = document.querySelector("#sample-btn") as HTMLButtonElement | null;

    const metricStatus = document.querySelector("#metric-status") as HTMLElement | null;
    const metricErrLine = document.querySelector("#metric-errline") as HTMLElement | null;
    const metricSize = document.querySelector("#metric-size") as HTMLElement | null;
    const metricLines = document.querySelector("#metric-lines") as HTMLElement | null;

    function formatBytes(bytes: number): string {
        if (bytes === 0) return "0 B";
        const k = 1024;
        const sizes = ["B", "KB", "MB"];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + " " + sizes[i];
    }

    // Extract error line from standard V8 / Browser parse errors or position offset
    function extractErrorLine(errorMessage: string, fullText: string): number | null {
        // Match formats like "(line 25 column 21)" or "at line 4"
        const lineMatch = errorMessage.match(/line (\d+)/i);
        if (lineMatch && lineMatch[1]) {
            return parseInt(lineMatch[1], 10);
        }

        // Fallback: match "at position 564" and compute line count up to that index
        const posMatch = errorMessage.match(/position (\d+)/i);
        if (posMatch && posMatch[1]) {
            const pos = parseInt(posMatch[1], 10);
            return fullText.slice(0, pos).split("\n").length;
        }

        return null;
    }

    function syncGutter(errorLine: number | null = null) {
        if (!jsonInput || !lineGutter) return;
        const totalLines = Math.max(1, jsonInput.value.split("\n").length);
        
        let html = "";
        for (let i = 1; i <= totalLines; i++) {
            const isError = errorLine === i;
            html += `<div class="gutter-num ${isError ? 'error-line-num' : ''}">${i}</div>`;
        }
        lineGutter.innerHTML = html;
    }

    function validate() {
        if (!jsonInput || !banner) return;
        const text = jsonInput.value;

        if (!text.trim()) {
            banner.className = "banner empty";
            banner.textContent = "Enter JSON to see validation results";
            syncGutter(null);
            if (metricStatus) { metricStatus.textContent = "-"; metricStatus.style.color = ""; }
            if (metricErrLine) metricErrLine.textContent = "-";
            if (metricSize) metricSize.textContent = "0 B";
            if (metricLines) metricLines.textContent = "0";
            return;
        }

        const byteLength = new TextEncoder().encode(text).length;
        const lineCount = text.split("\n").length;
        if (metricSize) metricSize.textContent = formatBytes(byteLength);
        if (metricLines) metricLines.textContent = lineCount.toString();

        try {
            JSON.parse(text);
            banner.className = "banner valid";
            banner.textContent = "✓ Valid JSON Format";
            syncGutter(null);

            if (metricStatus) {
                metricStatus.textContent = "Valid";
                metricStatus.style.color = "#16a34a";
            }
            if (metricErrLine) metricErrLine.textContent = "None";
        } catch (err: unknown) {
            const msg = err instanceof Error ? err.message : "Invalid JSON syntax";
            banner.className = "banner invalid";
            banner.textContent = `✕ ${msg}`;

            const errLine = extractErrorLine(msg, text);
            syncGutter(errLine);

            if (metricStatus) {
                metricStatus.textContent = "Invalid";
                metricStatus.style.color = "#dc2626";
            }
            if (metricErrLine) {
                metricErrLine.textContent = errLine ? `Line ${errLine}` : "Detected";
                metricErrLine.style.color = "#dc2626";
            }

            // Scroll error line into view if it was detected
            if (errLine) {
                const lineHeight = 22.4; // Matches line-height * font-size
                const scrollPos = (errLine - 4) * lineHeight;
                jsonInput.scrollTop = Math.max(0, scrollPos);
            }
        }
    }

    // Keep scroll position of line gutter synchronized with textarea scrolling
    jsonInput?.addEventListener("scroll", () => {
        if (lineGutter && jsonInput) {
            lineGutter.scrollTop = jsonInput.scrollTop;
        }
    });

    jsonInput?.addEventListener("input", validate);

    sampleBtn?.addEventListener("click", () => {
        if (jsonInput) {
            jsonInput.value = `{\n  "title": "Sample",\n  "count": 10,\n  "brokenKey": "missing comma"\n  "valid": true\n}`;
            validate();
        }
    });

    clearBtn?.addEventListener("click", () => {
        if (jsonInput) jsonInput.value = "";
        validate();
        jsonInput?.focus();
    });
</script>

<style>
    .tool-page { padding: 50px 0 90px; }
    .container { max-width: 1280px; margin: 0 auto; padding: 0 24px; width: 100%; }
    .tool-header { margin-bottom: 24px; }
    .back-link { display: block; margin-bottom: 12px; color: #6366f1; font-size: 13px; font-weight: 600; text-decoration: none; }
    .badge { display: inline-block; margin-bottom: 10px; font-size: 11px; font-weight: 800; letter-spacing: 1.2px; color: #6366f1; }
    .tool-header h1 { margin: 0 0 10px; font-size: clamp(32px, 4vw, 44px); letter-spacing: -1.5px; color: #111827; }
    .tool-header p { margin: 0; color: #64748b; font-size: 16px; }

    .validator-layout {
        display: grid;
        grid-template-columns: 1.6fr 1fr;
        gap: 24px;
        align-items: start;
    }

    .panel {
        display: flex;
        flex-direction: column;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
    }

    .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 18px;
        border-bottom: 1px solid #f1f5f9;
        background: #fafafa;
    }
    .panel-header label { font-size: 13px; font-weight: 700; color: #374151; text-transform: uppercase; letter-spacing: 0.5px; }

    .btn-ghost { background: transparent; border: none; color: #94a3b8; font-size: 12px; font-weight: 600; cursor: pointer; padding: 4px 8px; border-radius: 4px; }
    .btn-ghost:hover { color: #ef4444; }
    .btn-action { background: #eef2ff; border: 1px solid #c7d2fe; color: #4f46e5; font-size: 12px; font-weight: 700; padding: 4px 12px; border-radius: 6px; cursor: pointer; }
    .btn-action:hover { background: #e0e7ff; }

    /* Editor and Gutter */
    .editor-wrapper {
        display: flex;
        position: relative;
        background: #ffffff;
        min-height: 480px;
    }

    .line-gutter {
        width: 52px;
        padding: 16px 0;
        background: #f8fafc;
        border-right: 1px solid #e5e7eb;
        color: #94a3b8;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 14px;
        line-height: 1.6;
        text-align: right;
        user-select: none;
        overflow: hidden;
    }

    :global(.gutter-num) {
        padding-right: 12px;
        height: 22.4px; /* matches font-size * line-height */
        box-sizing: border-box;
    }

    :global(.error-line-num) {
        background: #fee2e2;
        color: #dc2626;
        font-weight: 800;
        border-left: 3px solid #dc2626;
        padding-right: 9px;
    }

    textarea {
        flex: 1;
        min-height: 480px;
        padding: 16px 18px;
        border: none;
        outline: none;
        resize: vertical;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 14px;
        line-height: 1.6;
        color: #1f2937;
        background: transparent;
        white-space: pre;
        overflow-x: auto;
    }

    .meta-panel { display: flex; flex-direction: column; gap: 18px; }
    .banner {
        padding: 16px 20px;
        border-radius: 10px;
        font-size: 14px;
        line-height: 1.5;
        font-weight: 600;
        word-break: break-word;
    }
    .banner.empty { background: #f8fafc; border: 1px solid #e2e8f0; color: #64748b; }
    .banner.valid { background: #f0fdf4; border: 1px solid #bbf7d0; color: #15803d; }
    .banner.invalid { background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; }

    .metrics-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 20px;
    }
    .metrics-card h3 { margin: 0 0 16px; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; color: #4b5563; }
    .metrics-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .metric { display: flex; flex-direction: column; gap: 4px; }
    .metric-label { font-size: 12px; color: #94a3b8; font-weight: 500; }
    .metric-value { font-size: 16px; font-weight: 700; color: #111827; }

    .privacy-tag { margin-top: 24px; color: #9ca3af; font-size: 13px; text-align: center; }

    @media (max-width: 820px) {
        .validator-layout { grid-template-columns: 1fr; }
        textarea, .editor-wrapper { min-height: 280px; }
    }
</style>