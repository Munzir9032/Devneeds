---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/global.css";
---

<BaseLayout
    title="URL Decoder - DevNeeds"
    description="Free online URL decoder. Decode percent-encoded strings, query strings, and complete URLs back into readable text instantly."
>
    <Header />

    <main class="tool-page">
        <div class="container">
            <!-- Breadcrumbs / Header -->
            <div class="tool-header">
                <a href="/tools" class="back-link">← All tools</a>
                <div class="badge">ENCODING</div>
                <h1>URL Decoder</h1>
                <p>Decode percent-encoded characters, query strings, and web addresses.</p>
            </div>

            <!-- Options Bar -->
            <div class="options-bar">
                <label class="radio-label">
                    <input type="radio" name="mode" value="component" checked />
                    <span>Decode Component (Query Values)</span>
                </label>
                <label class="radio-label">
                    <input type="radio" name="mode" value="full" />
                    <span>Decode Full URL</span>
                </label>
                <label class="checkbox-label">
                    <input type="checkbox" id="decode-plus" checked />
                    <span>Treat '+' as space</span>
                </label>
            </div>

            <!-- Tool Interface -->
            <div class="editor-grid">
                <!-- Input Panel -->
                <div class="panel">
                    <div class="panel-header">
                        <label for="input-text">Encoded Input</label>
                        <div class="panel-actions">
                            <button id="clear-btn" type="button" class="btn-ghost">Clear</button>
                        </div>
                    </div>
                    <textarea
                        id="input-text"
                        placeholder="Paste your percent-encoded URL or text here (e.g., hello%20world)..."
                        spellcheck="false"
                    ></textarea>
                </div>

                <!-- Output Panel -->
                <div class="panel">
                    <div class="panel-header">
                        <label for="output-text">Decoded Output</label>
                        <div class="panel-actions">
                            <button id="copy-btn" type="button" class="btn-action">
                                <span id="copy-label">Copy</span>
                            </button>
                        </div>
                    </div>
                    <textarea
                        id="output-text"
                        readonly
                        placeholder="Decoded text will appear here..."
                        spellcheck="false"
                    ></textarea>
                </div>
            </div>

            <div id="error-box" class="error-box" hidden>
                Invalid percent-encoded sequence. Please check your input.
            </div>

            <p class="privacy-tag">⚡ All conversions happen locally in your browser. No data leaves your machine.</p>
        </div>
    </main>

    <Footer />
</BaseLayout>

<script>
    const inputArea = document.getElementById("input-text") as HTMLTextAreaElement | null;
    const outputArea = document.getElementById("output-text") as HTMLTextAreaElement | null;
    const copyBtn = document.getElementById("copy-btn") as HTMLButtonElement | null;
    const copyLabel = document.getElementById("copy-label") as HTMLSpanElement | null;
    const clearBtn = document.getElementById("clear-btn") as HTMLButtonElement | null;
    const errorBox = document.getElementById("error-box") as HTMLDivElement | null;
    const modeRadios = document.querySelectorAll<HTMLInputElement>('input[name="mode"]');
    const plusCheckbox = document.getElementById("decode-plus") as HTMLInputElement | null;

    function decodeText() {
        if (!inputArea || !outputArea) return;
        let raw = inputArea.value;

        if (!raw.trim()) {
            outputArea.value = "";
            if (errorBox) errorBox.hidden = true;
            return;
        }

        if (plusCheckbox?.checked) {
            raw = raw.replace(/\+/g, " ");
        }

        const selectedMode = document.querySelector<HTMLInputElement>('input[name="mode"]:checked')?.value;

        try {
            const result = selectedMode === "full" ? decodeURI(raw) : decodeURIComponent(raw);
            outputArea.value = result;
            if (errorBox) errorBox.hidden = true;
        } catch {
            outputArea.value = "";
            if (errorBox) errorBox.hidden = false;
        }
    }

    inputArea?.addEventListener("input", decodeText);
    plusCheckbox?.addEventListener("change", decodeText);

    modeRadios.forEach((radio) => {
        radio.addEventListener("change", decodeText);
    });

    clearBtn?.addEventListener("click", () => {
        if (inputArea) inputArea.value = "";
        if (outputArea) outputArea.value = "";
        if (errorBox) errorBox.hidden = true;
        inputArea?.focus();
    });

    copyBtn?.addEventListener("click", async () => {
        if (!outputArea?.value) return;

        await navigator.clipboard.writeText(outputArea.value);
        if (copyLabel) {
            const original = copyLabel.textContent;
            copyLabel.textContent = "Copied!";
            setTimeout(() => {
                copyLabel.textContent = original;
            }, 1800);
        }
    });
</script>

<style>
    .tool-page {
        padding: 50px 0 90px;
    }

    .container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 24px;
        width: 100%;
    }

    .tool-header {
        margin-bottom: 24px;
    }

    .back-link {
        display: inline-block;
        margin-bottom: 16px;
        color: #6366f1;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
    }

    .badge {
        display: inline-block;
        margin-bottom: 10px;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.2px;
        color: #6366f1;
    }

    .tool-header h1 {
        margin: 0 0 10px;
        font-size: clamp(32px, 4vw, 44px);
        letter-spacing: -1.5px;
        color: #111827;
    }

    .tool-header p {
        margin: 0;
        color: #64748b;
        font-size: 16px;
    }

    .options-bar {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 16px;
        padding: 10px 16px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        width: fit-content;
    }

    .radio-label,
    .checkbox-label {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 13px;
        font-weight: 500;
        color: #475569;
        cursor: pointer;
    }

    .radio-label input,
    .checkbox-label input {
        cursor: pointer;
        accent-color: #4f46e5;
    }

    .editor-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .panel {
        display: flex;
        flex-direction: column;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
    }

    .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 18px;
        border-bottom: 1px solid #f1f5f9;
        background: #fafafa;
    }

    .panel-header label {
        font-size: 13px;
        font-weight: 700;
        color: #374151;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .btn-ghost {
        background: transparent;
        border: none;
        color: #94a3b8;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 4px;
        transition: color 0.15s ease;
    }

    .btn-ghost:hover {
        color: #ef4444;
    }

    .btn-action {
        background: #eef2ff;
        border: 1px solid #c7d2fe;
        color: #4f46e5;
        font-size: 12px;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: 6px;
        cursor: pointer;
        transition: background 0.15s ease;
    }

    .btn-action:hover {
        background: #e0e7ff;
    }

    textarea {
        width: 100%;
        min-height: 380px;
        padding: 18px;
        border: none;
        outline: none;
        resize: vertical;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 14px;
        line-height: 1.6;
        color: #1f2937;
        background: #ffffff;
        box-sizing: border-box;
    }

    textarea::placeholder {
        color: #9ca3af;
    }

    .error-box {
        margin-top: 16px;
        padding: 12px 16px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 8px;
        color: #dc2626;
        font-size: 14px;
        font-weight: 500;
    }

    .privacy-tag {
        margin-top: 18px;
        color: #9ca3af;
        font-size: 13px;
        text-align: center;
    }

    @media (max-width: 820px) {
        .editor-grid {
            grid-template-columns: 1fr;
        }

        .options-bar {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
            width: 100%;
        }

        textarea {
            min-height: 240px;
        }
    }
</style>