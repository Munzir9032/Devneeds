---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import "../styles/global.css";
---

<BaseLayout
    title="DevNeeds - Free Developer Tools"
    description="Free, fast and easy-to-use developer tools for developers. No login required."
>
    <Header />

    <main>
        <!-- Hero Section -->
        <section class="hero">
            <div class="hero-content">
                <div class="badge">
                    <span class="badge-dot"></span>
                    Free developer tools
                </div>

                <h1>
                    Everything developers
                    <span> need.</span>
                </h1>

                <p class="hero-description">
                    Simple, fast and powerful tools for everyday development.
                    Format, convert, encode, validate and transform your data
                    without installing anything.
                </p>

                <div class="search-box">
                    <span class="search-icon">⌕</span>

                    <input
                        type="text"
                        placeholder="Search developer tools..."
                        aria-label="Search developer tools"
                    />

                    <span class="search-shortcut">⌘ K</span>
                </div>

                <p class="privacy-note">
                    ⚡ Runs in your browser · No login required
                </p>
            </div>
        </section>


        <!-- Tools Preview -->
        <section class="section tools-section">
            <div class="section-header">
                <div>
                    <p class="eyebrow">DEVELOPER TOOLBOX</p>

                    <h2>Tools for your everyday work</h2>

                    <p class="section-description">
                        Everything you need, available in one place.
                    </p>
                </div>

                <a href="/tools" class="view-all">
                    View all tools →
                </a>
            </div>

            <div class="tool-grid">

                <div class="tool-card">
                    <div class="tool-icon">{ }</div>

                    <h3>Code & Data</h3>

                    <p>
                        Format, validate and transform your development data.
                    </p>

                    <span class="tool-link">
                        Explore →
                    </span>
                </div>


                <div class="tool-card">
                    <div class="tool-icon">↔</div>

                    <h3>Converters</h3>

                    <p>
                        Convert data between different formats quickly.
                    </p>

                    <span class="tool-link">
                        Explore →
                    </span>
                </div>


                <div class="tool-card">
                    <div class="tool-icon">#</div>

                    <h3>Encoding</h3>

                    <p>
                        Encode, decode and transform strings and data.
                    </p>

                    <span class="tool-link">
                        Explore →
                    </span>
                </div>


                <div class="tool-card">
                    <div class="tool-icon">⚙</div>

                    <h3>Developer Utilities</h3>

                    <p>
                        Handy utilities that make development easier.
                    </p>

                    <span class="tool-link">
                        Explore →
                    </span>
                </div>

            </div>
        </section>


        <!-- Why DevNeeds -->
        <section class="section why-section">

            <div class="why-content">

                <p class="eyebrow">WHY DEVNEEDS</p>

                <h2>
                    Built for developers,
                    <span>not distractions.</span>
                </h2>

                <p class="why-description">
                    DevNeeds is designed to make small development tasks
                    faster. No accounts, complicated interfaces or unnecessary
                    setup.
                </p>

                <div class="features">

                    <div class="feature">
                        <div class="feature-icon">⚡</div>

                        <div>
                            <h3>Fast</h3>
                            <p>
                                Get your result instantly without unnecessary
                                steps.
                            </p>
                        </div>
                    </div>


                    <div class="feature">
                        <div class="feature-icon">🔒</div>

                        <div>
                            <h3>Privacy focused</h3>
                            <p>
                                Our tools are designed to process your data
                                directly in your browser whenever possible.
                            </p>
                        </div>
                    </div>


                    <div class="feature">
                        <div class="feature-icon">∞</div>

                        <div>
                            <h3>Free to use</h3>
                            <p>
                                No account and no subscription required to use
                                the tools.
                            </p>
                        </div>
                    </div>


                    <div class="feature">
                        <div class="feature-icon">⌘</div>

                        <div>
                            <h3>Developer focused</h3>
                            <p>
                                Built around the small problems developers deal
                                with every day.
                            </p>
                        </div>
                    </div>

                </div>

            </div>

        </section>


        <!-- How It Works -->
        <section class="section how-section">

            <div class="section-header centered">

                <p class="eyebrow">SIMPLE BY DESIGN</p>

                <h2>Get things done in seconds</h2>

                <p class="section-description">
                    No complicated setup. Pick a tool, enter your data and get
                    your result.
                </p>

            </div>


            <div class="steps">

                <div class="step">
                    <div class="step-number">01</div>

                    <h3>Choose a tool</h3>

                    <p>
                        Find the tool you need from our developer toolbox.
                    </p>
                </div>


                <div class="step-line"></div>


                <div class="step">
                    <div class="step-number">02</div>

                    <h3>Enter your data</h3>

                    <p>
                        Paste or enter the data you want to work with.
                    </p>
                </div>


                <div class="step-line"></div>


                <div class="step">
                    <div class="step-number">03</div>

                    <h3>Get your result</h3>

                    <p>
                        Process your data instantly and continue your work.
                    </p>
                </div>

            </div>

        </section>


        <!-- Final CTA -->
        <section class="cta-section">

            <div class="cta-content">

                <p class="eyebrow">READY TO START?</p>

                <h2>Your developer toolbox is here.</h2>

                <p>
                    Explore the collection of free tools built to make
                    development a little easier.
                </p>

                <a href="/tools" class="cta-button">
                    Explore all tools →
                </a>

            </div>

        </section>

    </main>

    <Footer />
</BaseLayout>


<style>
    /* =========================
       HERO
    ========================= */

    .hero {
        padding: 92px 24px 82px;
        text-align: center;
        background:
            radial-gradient(
                circle at 50% 0%,
                rgba(99, 102, 241, 0.10),
                transparent 45%
            ),
            #ffffff;
    }

    .hero-content {
        max-width: 850px;
        margin: 0 auto;
    }

    .badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;

        padding: 6px 12px;

        border: 1px solid #e5e7eb;
        border-radius: 999px;

        background: #ffffff;

        color: #4b5563;
        font-size: 13px;
        font-weight: 500;

        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .badge-dot {
        width: 7px;
        height: 7px;

        border-radius: 50%;
        background: #22c55e;
    }

    .hero h1 {
		margin: 28px 0 20px;

		font-size: clamp(52px, 6vw, 78px);
        line-height: 1.04;
        letter-spacing: -2.8px;
        font-weight: 800;

        color: #111827;
    }

    .hero h1 span {
        background: linear-gradient(
            90deg,
            #4f46e5,
            #7c3aed
        );

        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .hero-description {
		max-width: 760px;
		margin: 0 auto;

		font-size: 19px;
        line-height: 1.6;

        color: #6b7280;
    }

    .search-box {
		max-width: 760px;

		margin: 32px auto 0;

        display: flex;
        align-items: center;

        padding: 7px 9px 7px 18px;

        border: 1px solid #d1d5db;
        border-radius: 11px;

        background: #ffffff;

        box-shadow:
            0 8px 25px rgba(0, 0, 0, 0.06);

        text-align: left;
    }

    .search-icon {
        font-size: 23px;
        color: #9ca3af;
        margin-right: 9px;
    }

    .search-box input {
        flex: 1;

        min-width: 0;

        border: none;
        outline: none;

        font-size: 15px;

        color: #111827;
        background: transparent;
    }

    .search-box input::placeholder {
        color: #9ca3af;
    }

    .search-shortcut {
        padding: 4px 7px;

        border: 1px solid #e5e7eb;
        border-radius: 6px;

        color: #9ca3af;
        font-size: 11px;
    }

    .privacy-note {
        margin-top: 12px;

        color: #9ca3af;
        font-size: 12px;
    }


    /* =========================
       GENERAL SECTIONS
    ========================= */

    .section {
        max-width: 1280px;

        margin: 0 auto;

        padding: 70px 24px;
    }

    .section-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;

        gap: 30px;

        margin-bottom: 32px;
    }

    .section-header.centered {
        display: block;

        max-width: 650px;

        margin-left: auto;
        margin-right: auto;

        text-align: center;
    }

    .eyebrow {
        margin: 0 0 8px;

        font-size: 11px;
        font-weight: 700;

        letter-spacing: 1.5px;

        color: #6366f1;
    }

    h2 {
        margin: 0;

		font-size: clamp(30px, 4vw, 42px);
        line-height: 1.15;

        letter-spacing: -1.3px;

        color: #111827;
    }

    .section-description {
        margin: 10px 0 0;

        color: #6b7280;

        font-size: 16px;
        line-height: 1.6;
    }

    .view-all {
        white-space: nowrap;

        color: #4f46e5;

        font-size: 14px;
        font-weight: 600;
    }


    /* =========================
       TOOL CARDS
    ========================= */

    .tool-grid {
        display: grid;

        grid-template-columns: repeat(4, 1fr);

        gap: 16px;
    }

    .tool-card {
        padding: 24px;

        border: 1px solid #e5e7eb;
        border-radius: 13px;

        background: #ffffff;

        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease,
            border-color 0.2s ease;
    }

    .tool-card:hover {
        transform: translateY(-3px);

        border-color: #c7d2fe;

        box-shadow:
            0 12px 30px rgba(0, 0, 0, 0.07);
    }

    .tool-icon {
        width: 42px;
        height: 42px;

        display: flex;
        align-items: center;
        justify-content: center;

        margin-bottom: 18px;

        border-radius: 9px;

        background: #eef2ff;

        color: #4f46e5;

        font-size: 19px;
        font-weight: 700;
    }

    .tool-card h3 {
        margin: 0 0 8px;

        font-size: 17px;
        color: #111827;
    }

    .tool-card p {
        min-height: 64px;

        margin: 0;

        color: #6b7280;

        font-size: 13px;
        line-height: 1.55;
    }

    .tool-link {
        display: inline-block;

        margin-top: 17px;

        color: #4f46e5;

        font-size: 13px;
        font-weight: 600;
    }


    /* =========================
       WHY DEVNEEDS
    ========================= */

    .why-section {
        max-width: none;

        background: #f9fafb;

        padding-left: max(24px, calc((100% - 1152px) / 2));
        padding-right: max(24px, calc((100% - 1152px) / 2));
    }

    .why-content {
        max-width: 1152px;
        margin: 0 auto;
    }

    .why-description {
        max-width: 650px;

        margin: 16px 0 38px;

        color: #6b7280;

        font-size: 16px;
        line-height: 1.65;
    }

    .features {
        display: grid;

        grid-template-columns: repeat(2, 1fr);

        gap: 18px;
    }

    .feature {
        display: flex;

        gap: 16px;

        padding: 22px;

        border: 1px solid #e5e7eb;
        border-radius: 11px;

        background: #ffffff;
    }

    .feature-icon {
        flex-shrink: 0;

        width: 40px;
        height: 40px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 8px;

        background: #eef2ff;

        font-size: 17px;
    }

    .feature h3 {
        margin: 0 0 5px;

        font-size: 16px;
    }

    .feature p {
        margin: 0;

        color: #6b7280;

        font-size: 13px;
        line-height: 1.55;
    }


    /* =========================
       HOW IT WORKS
    ========================= */

    .how-section {
        padding-bottom: 80px;
    }

    .steps {
        display: flex;

        align-items: center;

        max-width: 900px;

        margin: 45px auto 0;
    }

    .step {
        flex: 1;

        text-align: center;
    }

    .step-number {
        margin-bottom: 14px;

        color: #6366f1;

        font-size: 12px;
        font-weight: 800;

        letter-spacing: 1px;
    }

    .step h3 {
        margin: 0 0 7px;

        font-size: 17px;
    }

    .step p {
        margin: 0;

        color: #6b7280;

        font-size: 13px;
        line-height: 1.5;
    }

    .step-line {
        width: 60px;
        height: 1px;

        margin: 0 18px;

        background: #e5e7eb;
    }


    /* =========================
       CTA
    ========================= */

    .cta-section {
        margin: 0 24px 70px;

        border-radius: 18px;

        background: #111827;

        color: #ffffff;

        text-align: center;
    }

    .cta-content {
        max-width: 700px;

        margin: 0 auto;

        padding: 60px 24px;
    }

    .cta-content .eyebrow {
        color: #a5b4fc;
    }

    .cta-content h2 {
        color: #ffffff;

        margin-bottom: 13px;
    }

    .cta-content p:not(.eyebrow) {
        max-width: 550px;

        margin: 0 auto 26px;

        color: #9ca3af;

        line-height: 1.6;
    }

    .cta-button {
        display: inline-block;

        padding: 12px 20px;

        border-radius: 8px;

        background: #ffffff;

        color: #111827;

        font-size: 14px;
        font-weight: 700;

        transition: transform 0.2s ease;
    }

    .cta-button:hover {
        transform: translateY(-2px);
    }


    /* =========================
       TABLET
    ========================= */

    @media (max-width: 900px) {

        .tool-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .features {
            grid-template-columns: 1fr;
        }

        .steps {
            flex-direction: column;
            gap: 30px;
        }

        .step-line {
            width: 1px;
            height: 30px;

            margin: 0;
        }
    }


    /* =========================
       MOBILE
    ========================= */

    @media (max-width: 640px) {

        .hero {
            padding: 92px 24px 82px;
        }

        .hero h1 {
            font-size: 44px;
            letter-spacing: -2px;
        }

        .hero-description {
            font-size: 15px;
        }

        .search-shortcut {
            display: none;
        }

        .section {
            padding: 55px 20px;
        }

        .section-header {
            display: block;
        }

        .view-all {
            display: inline-block;

            margin-top: 17px;
        }

        .tool-grid {
            grid-template-columns: 1fr;
        }

        .tool-card p {
            min-height: auto;
        }

        .cta-section {
            margin: 0 15px 50px;
        }

        .cta-content {
            padding: 48px 20px;
        }
    }
</style>